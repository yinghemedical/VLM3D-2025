# Copy to pipeline.env and edit for your environment.
# This file is sourced by pipeline/run_case.sh.

# Root of this code repository.
VLM3D_ROOT="/path/to/VLM3D-2025"

# Root of the separate weights repository.
WEIGHTS_ROOT="/path/to/VLM3D-2025-weights"
CT_CLS_CKPT_DIR="${WEIGHTS_ROOT}/classification/ct_cls8"

# CT_CLS8 code tree. It must contain process.py and a local
# nnUNet_results symlink pointing at the Dataset665 weights.
CT_CLS_ROOT="${VLM3D_ROOT}/code/classification/inference"

# Report-generation 8B checkpoint and local encoder/LLM assets.
REPORT_SRC_MODEL="${WEIGHTS_ROOT}/report_generation/final-8b"
REPORT_RUNTIME_MODEL="${WEIGHTS_ROOT}/report_generation/runtime-8b-ctrate"
CACHE_DIR="/path/to/hf_cache"
SIGLIP_DIR="${CACHE_DIR}/models--google--siglip2-so400m-patch14-384/snapshots/e8e487298228002f3d8a82e0cd5c8ea9c567f57f"
QWEN_DIR="${CACHE_DIR}/Qwen3-8B"

# MedM-VL code directory.
MEDMVL_ROOT="${VLM3D_ROOT}/code/report_generation/MedM-VL"
